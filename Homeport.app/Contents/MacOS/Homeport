#!/bin/bash
# Opens Homeport, starting the server first if needed.
# The project folder is the one containing this .app, so it keeps working
# if the folder is moved or renamed. Keep the app inside the project folder
# (put an alias in /Applications or the Dock instead of moving it).

APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
DIR="$(dirname "$APP_DIR")"
URL="http://127.0.0.1:7777"

if [ ! -f "$DIR/backend/main.py" ] || [ ! -x "$DIR/.venv/bin/python" ]; then
    osascript -e 'display alert "Homeport can’t start" message "Keep Homeport.app inside its project folder, and make sure the .venv folder exists there (double-click run.command once to check)." as critical' >/dev/null 2>&1
    exit 1
fi

if ! curl -s --connect-timeout 1 "$URL/api/health" >/dev/null 2>&1; then
    # Use the login LaunchAgent if installed, otherwise start in the background
    launchctl start com.localhostmanager.server 2>/dev/null || {
        mkdir -p "$DIR/data/logs"
        cd "$DIR" && \
        PYTHONPATH="$DIR" \
        nohup "$DIR/.venv/bin/python" -m uvicorn backend.main:app --host 127.0.0.1 --port 7777 >> "$DIR/data/logs/server.log" 2>&1 &
    }
    # Wait up to ~5 seconds for the server
    for i in {1..50}; do
        if curl -s --connect-timeout 1 "$URL/api/health" >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done
fi

open "$URL/"
exit 0
